<?xml version="1.0"?>
<package format="3">
  <name>system_monitor_dashboard</name>
  <version>0.1.0</version>
  <description>System status publisher and PyQt5 dashboard for ROS 2 Humble.</description>
  <maintainer email="LCY123229@users.noreply.github.com">System Monitor Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>system_monitor_interfaces</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
